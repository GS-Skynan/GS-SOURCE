 69441                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 69442                           ;	Multi-vector enable bit
 69443                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
 69444                           ;	IVTLOCK bit One-way set enable bit
